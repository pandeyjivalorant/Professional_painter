generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  slug         String     @unique
  description  String?
  displayOrder Int        @default(0)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  paintings    Painting[]

  @@index([slug, deletedAt])
  @@index([displayOrder])
}

model Painting {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  description    String?
  story          String?
  price          Decimal?        @db.Decimal(10, 2)
  originalPrice  Decimal?        @db.Decimal(10, 2)
  currency       String          @default("INR")
  year           Int?
  status         PaintingStatus  @default(AVAILABLE)
  isPublished    Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  displayOrder   Int             @default(0)
  style          String?
  medium         String?
  materials      String?
  tags           String[]        @default([])
  colors         String[]        @default([])
  width          Decimal?        @db.Decimal(10, 2)
  height         Decimal?        @db.Decimal(10, 2)
  unit           String?         @default("inches")
  isFramed       Boolean         @default(false)
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       Category?       @relation(fields: [categoryId], references: [id])
  images         PaintingImage[]

  @@index([slug, deletedAt])
  @@index([categoryId, deletedAt])
  @@index([status, deletedAt])
  @@index([isPublished, isFeatured, deletedAt])
  @@index([displayOrder])
}

model PaintingImage {
  id           String    @id @default(uuid())
  url          String
  alt          String?
  width        Int?
  height       Int?
  format       String?
  sizeBytes    Int?
  isMain       Boolean   @default(false)
  displayOrder Int       @default(0)
  paintingId   String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  blurDataUrl  String?
  painting     Painting  @relation(fields: [paintingId], references: [id], onDelete: Cascade)

  @@index([paintingId, deletedAt])
  @@index([displayOrder])
}

model Certificate {
  id           String    @id @default(uuid())
  title        String
  description  String?
  imageUrl     String
  issuedBy     String?
  issueDate    DateTime?
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deletedAt])
  @@index([displayOrder])
}

model Testimonial {
  id           String    @id @default(uuid())
  clientName   String
  text         String
  rating       Int?      @default(5)
  role         String?
  isPublished  Boolean   @default(true)
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished, deletedAt])
  @@index([displayOrder])
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isRead, deletedAt])
  @@index([createdAt])
}

model ADMIN {
  id        String    @id
  name      String?
  email     String    @unique
  password  String
  role      Role      @default(ADMIN)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime

  @@index([email, deletedAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum PaintingStatus {
  AVAILABLE
  RESERVED
  SOLD
  NOT_FOR_SALE
}
